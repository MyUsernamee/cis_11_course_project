; frequency_counter.lc3
; The main core logic of the project, takes in a name 
; and stores the counts of each letter in an array.
; These will be subroutines and there will be a 
; test project in this file, where later it
; will be merged with other's code for the
; final program.

.ORIG x3000

BRnzp main

INPUT_PROMPT .STRINGZ "Please enter a name: "
CAP_START .STRINGZ "A" ; ASCII Value of A
LOWER_START .STRINGZ "a" ; ASCII Value of a
SPACE .STRINGZ " " ; ASCII Value of " "
zero .FILL #0
p26 .FILL #26
NEW_LINE .STRINGZ "\n"
BKSP .FILL x08
OUTPUT_SEPARATOR .STRINGZ ": "
COUNTER_TEST_LOC .BLKW 26 ; counts array, contains the counts of every letter, i.e. counts[0] is the number of times 'a' appears
NAME_INPUT_BUFFER .BLKW 32

main 
    LD R1, zero
    LD R2, zero
    LD R3, zero
    LD R4, zero
    LD R5, zero
    LEA R0, INPUT_PROMPT
    PUTS
    LEA R1, NAME_INPUT_BUFFER
    JSR input
    JSR string_lower
    LEA R2, COUNTER_TEST_LOC
    JSR counter
    ADD R1, R2, #0
    JSR output
    HALT

output
    
ADD R6, R6, #-1
STR R7, R6, #0
ADD R6, R6, #-1
STR R1, R6, #0
ADD R6, R6, #-1
STR R2, R6, #0
ADD R6, R6, #-1
STR R3, R6, #0 
ADD R6, R6, #-1
STR R4, R6, #0 
ADD R6, R6, #-1
STR R5, R6, #0 ; Save R1-R5, R7 to stack
    LD R2, zero
    LD R4, CAP_START
    ADD R5, R1, #0

    LD R3, p26
    NOT R3, R3
    ADD R3, R3, #1 ; Invert R3       

    output_loop
        ADD R0, R2, R4
        OUT

        LEA R0, OUTPUT_SEPARATOR
        PUTS
        
        LDR R1, R5, #0
        JSR print_num ; Convert R1 to String
        PUTS

        LD R0, NEW_LINE
        OUT

        ADD R2, R2, #1
        ADD R5, R5, #1
        ADD R0, R3, R2
        BRz output_exit
        BRnzp output_loop

    output_exit
    LDR R7, R6, #5
LDR R1, R6, #4
LDR R2, R6, #3
LDR R3, R6, #2
LDR R4, R6, #1
LDR R5, R6, #0
ADD R6, R6, #6
    RET
        
        
        
KBSR .FILL xFE00

input ; Reads string until new line to buffer location in R1
    
ADD R6, R6, #-1
STR R7, R6, #0
ADD R6, R6, #-1
STR R1, R6, #0
ADD R6, R6, #-1
STR R2, R6, #0
ADD R6, R6, #-1
STR R3, R6, #0 
ADD R6, R6, #-1
STR R4, R6, #0 
ADD R6, R6, #-1
STR R5, R6, #0 ; Save R1-R5, R7 to stack
    LD R2, NEW_LINE
    LD R3, zero
    LD R4, BKSP
    ADD R5, R1, #0

    NOT R2, R2
    ADD R2, R2, #1

    NOT R4, R4
    ADD R4, R4, #1

    NOT R5, R5
    ADD R5, R5, #1

    input_loop
        GETC

        ADD R6, R6, #-1 
        STR R5, R6, #0

        LD R3, zero
        LD R5, KBSR
        STR R3, R5, #0 ; Reset KBSR
        
        LDR R5, R6, #0
        ADD R6, R6, #1

        ADD R3, R0, R2
        BRz input_exit ; Enter

        ADD R3, R0, R4
        BRz input_loop_dec ; Backspace

        STR R0, R1, #0
        ADD R1, R1, #1
        OUT
        BRnzp input_loop

        input_loop_dec
        ADD R3, R5, R1
        BRz input_loop
        ADD R1, R1, #-1
        OUT
        BRnzp input_loop

    input_exit
    OUT
    LD R3, zero
    STR R3, R1, #0
    LDR R7, R6, #5
LDR R1, R6, #4
LDR R2, R6, #3
LDR R3, R6, #2
LDR R4, R6, #1
LDR R5, R6, #0
ADD R6, R6, #6
    RET
    
string_lower ; Routine that makes all letters in a string lowercase.
    
ADD R6, R6, #-1
STR R7, R6, #0
ADD R6, R6, #-1
STR R1, R6, #0
ADD R6, R6, #-1
STR R2, R6, #0
ADD R6, R6, #-1
STR R3, R6, #0 
ADD R6, R6, #-1
STR R4, R6, #0 
ADD R6, R6, #-1
STR R5, R6, #0 ; Save R1-R5, R7 to stack
    
    AND R0, R0, #0 ; R0 = 0
    string_lower_iter 
        LDR R2, R1, #0 ; R2 = counts[i]
        BRz string_lower_done 

            LD R3, LOWER_START
            NOT R3, R3
            ADD R3, R3, #1 ; R3 = -'a'
            ADD R3, R3, R2 ; R3 = R2 - 'a'

            BRp string_lower_iter_inc  ; If (R2 > 'a') continue;
            LD R2, LOWER_START 
            ADD R3, R3, R2 ; R3 = R2 + 'a' (undo last subtraction)
            
            LD R2, CAP_START
            NOT R2, R2
            ADD R2, R2, #1 ; R2 = -'A'
            ADD R3, R3, R2 ; R3 -= 'A'

            BRn string_lower_iter_inc ; if (R3 < 'A') continue; (If our character is less than 'A' in the ascii table, leave it alone)

            LD R2, p26 
            NOT R2, R2
            ADD R2, R2, #1 ; R2 = -26
            ADD R3, R3, R2 ; R3 -= 26

            BRp string_lower_iter_inc ; if (R3 > 'Z') continue; (Leave our character alone if it is not a upper case letter)

            NOT R2, R2
            ADD R2, R2, #1
            ADD R3, R3, R2 ; R3 += 26;

            LD R2, LOWER_START
            ADD R3, R3, R2
            STR R3, R1, #0 ; string[i] = lower(string[i]) = string[i] - 'A' + 'a'

        string_lower_iter_inc
            ADD R1, R1, #1 ; i++ | R1++

        BRnzp string_lower_iter 

    string_lower_done ; return
    
    LDR R7, R6, #5
LDR R1, R6, #4
LDR R2, R6, #3
LDR R3, R6, #2
LDR R4, R6, #1
LDR R5, R6, #0
ADD R6, R6, #6
    RET

counter ; R1 string to count, R2 output array location
    
ADD R6, R6, #-1
STR R7, R6, #0
ADD R6, R6, #-1
STR R1, R6, #0
ADD R6, R6, #-1
STR R2, R6, #0
ADD R6, R6, #-1
STR R3, R6, #0 
ADD R6, R6, #-1
STR R4, R6, #0 
ADD R6, R6, #-1
STR R5, R6, #0 ; Save R1-R5, R7 to stack
    
    ; We will use R0, as our "constant register". We will use it to load constants from memory, i.e. LOWER_START
    ; R1-5 will be used in decreasing orders of access frequency.
    ; i.e. If only need to store something once then
    ; read it a bunch of times, it should be in R5

    LD R5, p26
    NOT R5, R5
    ADD R5, R5, #-1 ; Load 26 into R5

    AND R0, R0, #0
    AND R4, R4, #0 ; Clear R0, R4
    ; i = R4
    counter_zero_stack_loop ; Clear counts array
        ADD R3, R4, R5 ; Add 26 to i
        BRz counter_zero_stack_loop_exit ; break if i < 26

        ADD R3, R4, R2
        STR R0, R3, #0 ; counts[i] = 0;
        ADD R4, R4, #1
    counter_zero_stack_loop_exit

    counter_iter 
        LDR R5, R1, #0  ; R5 = string[R1];
        BRz counter_done 
            LD R0, LOWER_START
            NOT R0, R0
            ADD R0, R0, #1 ; R0 = 'a';
    
            ADD R5, R5, R0
            BRn counter_continue ; if (string[i] < 'a') continue;

            LD R0, p26
            NOT R0, R0
            ADD R0, R0, #1  ; R0 = -26
            ADD R5, R5, R0 ; R5 -= 26;
            BRp counter_continue ; if (string[i] > 'z') continue;

            NOT R0, R0
            ADD R0, R0, #1 ; R0 = -R0 = 26
            ADD R5, R5, R0 ; R5 += 26;
            
            ADD R4, R2, R5
            LDR R3, R4, #0
            ADD R3, R3, #1
            STR R3, R4, #0 ; counts[i] += 1
        counter_continue
        ADD R1, R1, #1 ; i++ | R1++
    BRnzp counter_iter

    counter_done ; return

    LDR R7, R6, #5
LDR R1, R6, #4
LDR R2, R6, #3
LDR R3, R6, #2
LDR R4, R6, #1
LDR R5, R6, #0
ADD R6, R6, #6
    RET       

div ; Divide R1 by R2, output result in R0
    
ADD R6, R6, #-1
STR R7, R6, #0
ADD R6, R6, #-1
STR R1, R6, #0
ADD R6, R6, #-1
STR R2, R6, #0
ADD R6, R6, #-1
STR R3, R6, #0 
ADD R6, R6, #-1
STR R4, R6, #0 
ADD R6, R6, #-1
STR R5, R6, #0 ; Save R1-R5, R7 to stack
    AND R0, R0, #0

    NOT R2, R2
    ADD R2, R2, #1 ; Negate R2
    
    div_loop
        ADD R1, R1, R2
        BRn div_exit
        ADD R0, R0, #1
        BRnzp div_loop
    
    div_exit
    LDR R7, R6, #5
LDR R1, R6, #4
LDR R2, R6, #3
LDR R3, R6, #2
LDR R4, R6, #1
LDR R5, R6, #0
ADD R6, R6, #6
    RET

mod ; Divide R1 by R2, output remainder in R0
    
ADD R6, R6, #-1
STR R7, R6, #0
ADD R6, R6, #-1
STR R1, R6, #0
ADD R6, R6, #-1
STR R2, R6, #0
ADD R6, R6, #-1
STR R3, R6, #0 
ADD R6, R6, #-1
STR R4, R6, #0 
ADD R6, R6, #-1
STR R5, R6, #0 ; Save R1-R5, R7 to stack
    AND R0, R0, #0

    NOT R2, R2
    ADD R2, R2, #1 ; Negate R2
    
    mod_loop
        ADD R1, R1, R2
        BRn mod_exit
        BRnzp mod_loop
    mod_exit
    
    NOT R2, R2
    ADD R2, R2, #1
    ADD R0, R1, R2
    LDR R7, R6, #5
LDR R1, R6, #4
LDR R2, R6, #3
LDR R3, R6, #2
LDR R4, R6, #1
LDR R5, R6, #0
ADD R6, R6, #6
    RET

print_num ; Prints the number in R1
    
ADD R6, R6, #-1
STR R7, R6, #0
ADD R6, R6, #-1
STR R1, R6, #0
ADD R6, R6, #-1
STR R2, R6, #0
ADD R6, R6, #-1
STR R3, R6, #0 
ADD R6, R6, #-1
STR R4, R6, #0 
ADD R6, R6, #-1
STR R5, R6, #0 ; Save R1-R5, R7 to stack
    LD R2, ten 
    LD R3, five
    LEA R4, PRINT_NUMBER_BUFFER
    LD R5, NUMBER_START
    ADD R4, R4, #5

    print_num_loop
        ADD R4, R4, #-1
        ADD R3, R3, #-1
        BRz print_num_exit
        JSR mod 
        ADD R0, R0, R5
        STR R0, R4, #0
        JSR div
        ADD R1, R0, #0
        BRnzp print_num_loop

    print_num_exit
    LEA R0, PRINT_NUMBER_BUFFER

    LDR R7, R6, #5
LDR R1, R6, #4
LDR R2, R6, #3
LDR R3, R6, #2
LDR R4, R6, #1
LDR R5, R6, #0
ADD R6, R6, #6
    RET

ten .FILL #10 
five .FILL #6
NUMBER_START .STRINGZ "0"
PRINT_NUMBER_BUFFER .STRINGZ "     "

.END
